# Local-only Grafana sign-in. Change these before exposing anything beyond localhost.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana-lab-only-change-me

# Web UIs are published on loopback only.
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
TEMPO_PORT=3200
ALERTMANAGER_PORT=9093
WEBHOOK_RECEIVER_PORT=8090
BLACKBOX_EXPORTER_PORT=9115

# Local-only simulated application and database.
APP_PORT=8080
POSTGRES_PORT=5432
POSTGRES_DB=observability
POSTGRES_USER=labuser
POSTGRES_PASSWORD=lab-postgres-only-change-me
CHAOS_ADMIN_TOKEN=local-chaos-token-change-me

# Exporter metrics endpoints (bound to loopback).
NGINX_EXPORTER_PORT=9113
POSTGRES_EXPORTER_PORT=9187

# Compose project label used to collect only this lab's container logs.
COMPOSE_PROJECT_NAME=grafana
LOKI_PORT=3100
ALLOY_PORT=12345

# Optional default for the profile-only k6 runner.
K6_SCENARIO=steady
